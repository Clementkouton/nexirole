// NexiRole — Authentification Auth.js v5 + PostgreSQL (Neon)
// Prisma 7 : les URLs de connexion vivent dans prisma.config.ts
// (plus de url/directUrl ici) et le client est généré dans src/generated/prisma.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Utilisateur ──────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // Bcrypt coût 12 — null = compte Google uniquement
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  // Historique NexiRole
  generatedDossiers GeneratedDossier[]
  scanRuns          ScanRun[]

  @@map("users")
}

// ── Comptes OAuth (Google...) — requis par Auth.js ───────────
model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ── Sessions base de données (présentes pour compatibilité) ──
model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ── Tokens de vérification (requis par Auth.js) ──────────────
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ── Réinitialisation de mot de passe ─────────────────────────
model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique // SHA-256 du token envoyé par email — jamais le token brut
  expires DateTime

  @@index([email])
  @@map("password_reset_tokens")
}

// ── HISTORIQUE : dossiers générés (CV + lettre + kit entretien) ──
model GeneratedDossier {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offreTitre String   // Intitulé de l'offre ciblée (ou "CV générique")
  offreUrl   String?
  offreEntreprise String?
  templateId String   @default("modern-accent")
  data       Json     // Dossier complet : identite, experiences, lettre, kit...
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("generated_dossiers")
}

// ── HISTORIQUE : scans de l'Agent de recherche ───────────────
model ScanRun {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requete    String?  // Terme de recherche saisi (null = recherche intelligente)
  region     String?
  remoteOnly Boolean  @default(false)
  motscles   Json?    // Mots-clés déduits du CV : { titre, motsCles[] }
  resultats  Json     // Offres scorées (descriptions tronquées)
  nbOffres   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("scan_runs")
}