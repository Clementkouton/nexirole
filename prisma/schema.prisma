// NexiRole — Authentification Auth.js v5 + PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Utilisateur ──────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // Bcrypt coût 12 — null = compte Google uniquement
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  resetTokens PasswordResetToken[]

  @@map("users")
}

// ── Comptes OAuth (Google...) — requis par Auth.js ───────────
model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ── Sessions base de données (présentes pour compatibilité) ──
model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ── Tokens de vérification (requis par Auth.js) ──────────────
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ── Réinitialisation de mot de passe ─────────────────────────
model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique // SHA-256 du token envoyé par email — jamais le token brut
  expires DateTime

  @@index([email])
  @@map("password_reset_tokens")
}