# ============================================================
#  NEXIROLE — Variables d'environnement (AUCUNE vraie clé ici)
#  Copiez ce fichier en .env.local puis remplacez chaque valeur
#  par vos propres clés. Ne committez JAMAIS .env.local.
# ============================================================

# ── Base de données (Neon / PostgreSQL) ──────────────────────
DATABASE_URL=postgres://user:password@host/db?sslmode=require
DIRECT_URL=postgres://user:password@host/db?sslmode=require

# ── Auth.js v5 ───────────────────────────────────────────────
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_GOOGLE_ID=your_google_oauth_client_id_here
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret_here
APP_URL=http://localhost:3000

# ── IA (Groq) ────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Facultatif : modèle vision pour lire les CV en image
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Facultatif : modèle texte principal (replis automatiques inclus)
# GROQ_MODEL=openai/gpt-oss-120b

# ── Chariow (licences) — PARTIE 1 ────────────────────────────
# Clé API (sk_live_...) : Dashboard Chariow → Developer → API Keys
CHARIOW_API_KEY=your_chariow_api_key_here
# Secret du Pulse (whsec_...) : Dashboard Chariow → Automation → Pulses
CHARIOW_WEBHOOK_SECRET=your_chariow_webhook_secret_here
# Checkouts publics affichés sur /pricing
NEXT_PUBLIC_CHARIOW_BOOST_URL=https://votre-boutique.mychariow.com/pass-boost/checkout
NEXT_PUBLIC_CHARIOW_PRO_URL=https://votre-boutique.mychariow.com/carriere-pro/checkout
# Facultatif : mapping direct des produits Chariow → plans
# CHARIOW_PRODUCT_BOOST_ID=prd_xxxxxxxxxxxx
# CHARIOW_PRODUCT_PRO_ID=prd_xxxxxxxxxxxx
# Facultatif : base de l'API Chariow (défaut https://api.chariow.com/v1)
# CHARIOW_API_BASE=https://api.chariow.com/v1
